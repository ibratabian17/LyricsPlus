# ==============================================================================
# LyricsPlus Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server Tuning
PORT=3000
MAX_CONCURRENCY=15000
MAX_URL_BYTES=4096
MAX_QUERY_PARAMS=20
MAX_QUERY_VALUE_LEN=500
SHUTDOWN_TIMEOUT_MS=10000

# Proxy Configuration (Optional SSRF-safe forward proxy)
SERVER_PROXY_ENABLED=false
# Comma-separated list of forward proxies; one is picked at random per request.
SERVER_PROXY_URLS=https://proxy-lyplus.prjktla.workers.dev/?url=
SERVER_PROXY_URL=https://proxy-lyplus.prjktla.workers.dev/?url=
SERVER_PROXY_TOKEN_HEADER=x-proxy-token
SERVER_PROXY_TOKEN=

# Structured Logging
DISABLE_LOGGING=false
LOG_LEVEL=info
LOG_FORMAT=text

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_MS=10000

# LyricsPlus UGC Submission API (PoW & JWT)
JWT_SECRET=your-secure-jwt-secret
LYRICSPLUS_CHALLENGE_TTL_MS=600000
LYRICSPLUS_POW_DIFFICULTY=5
MAX_BODY_BYTES=1048576
LYRICSPLUS_ACCEPT_VANDALISM=false
ALLOW_SUBMISSIONS=true

# Storage & Cache
SQLITE_PATH=database/lyrics_cache.db
LRU_SIZE=4096
CONTENT_CACHE_BYTES=50331648
EXACT_TTL_MS=900000
EXISTING_TTL_MS=900000
NEGATIVE_TTL_MS=30000
HTTP_CACHE_MAX_KEYS=2000
HTTP_CACHE_MAX_BYTES=100663296
HTTP_CACHE_MAX_BODY_BYTES=1572864
MEMORY_WATCHDOG_BYTES=3221225472

# Google Drive Storage & Backup
GDRIVE_ENABLED=false
GDRIVE_CIRCUIT_BREAKER_THRESHOLD=5
GDRIVE_CIRCUIT_BREAKER_COOLDOWN_MS=60000
DAILY_DUMP_ENABLED=false
DAILY_DUMP_INTERVAL_HOURS=24
DAILY_DUMP_DIR=data/dumps

# Google Drive OAuth Credentials (or use auth.json)
AUTH_KEY_CLIENT_ID=
AUTH_KEY_CLIENT_SECRET=
AUTH_KEY_REFRESH_TOKEN=
AUTH_KEY_ROOT=
# Or multiple accounts: GDRIVE_ACCOUNTS='CLIENT_ID|CLIENT_SECRET|REFRESH_TOKEN|ROOT,...'

# Google Drive Folder IDs
GDRIVE_USERTML_JSON=
GDRIVE_CACHED_TTML=
GDRIVE_CACHED_SPOTIFY=
GDRIVE_CACHED_MUSIXMATCH=
GDRIVE_CACHED_QQ=
GDRIVE_CACHED_DEEZER=
GDRIVE_BACKUP_FOLDER=

# Provider Tuning
PROVIDER_TIMEOUT_MS=8000

# Spotify
SPOTIFY_SECRETS_URL=https://raw.githubusercontent.com/Thereallo1026/spotify-secrets/main/secrets/secretDict.json
SPOTIFY_COOKIE=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Multi-account (JSON array). When set, it overrides the scalar SPOTIFY_* vars.
# SPOTIFY_ACCOUNTS='[{"NAMEID":"acc1","CLIENT_ID":"...","CLIENT_SECRET":"...","COOKIE":"..."}]'

# Musixmatch
MUSIXMATCH_COOKIE=
MUSIXMATCH_USER_AGENT=
MUSIXMATCH_ANDROID_EMAIL=
MUSIXMATCH_ANDROID_PASSWORD=
# Multi-account (JSON array). AUTH_TYPE is "web" (COOKIE) or "android" (EMAIL/PASSWORD).
# When set, it overrides the scalar MUSIXMATCH_* vars.
# MUSIXMATCH_ACCOUNTS='[{"NAMEID":"WebGuest","AUTH_TYPE":"web","USER_AGENT":"","COOKIE":""},{"NAMEID":"Android1","AUTH_TYPE":"android","EMAIL":"","PASSWORD":""}]'

# Apple Music
APPLE_MUSIC_ANDROID_AUTH_TOKEN=
APPLE_MUSIC_ANDROID_DSID=
APPLE_MUSIC_ANDROID_USER_AGENT=
APPLE_MUSIC_ANDROID_COOKIE=
APPLE_MUSIC_STOREFRONT=in
APPLE_MUSIC_AUTH_TOKEN=
# Multi-account (JSON array). When set, it overrides the scalar APPLE_MUSIC_* vars.
# APPLE_MUSIC_ACCOUNTS='[{"NAMEID":"Android1","AUTH_TYPE":"android","ANDROID_AUTH_TOKEN":"","ANDROID_DSID":"","ANDROID_USER_AGENT":"","ANDROID_COOKIE":"","STOREFRONT":"in"},{"NAMEID":"Web1","AUTH_TYPE":"web","MUSIC_AUTH_TOKEN":""}]'

# QQ Music & Deezer
QQ_COOKIE=
DEEZER_ARL=
DEEZER_REFRESH_TOKEN=
# Deezer multi-account (JSON array). When set, it overrides DEEZER_ARL/DEEZER_REFRESH_TOKEN.
# DEEZER_ACCOUNTS='[{"NAMEID":"acc1","REFRESH_TOKEN":"..."}]'
